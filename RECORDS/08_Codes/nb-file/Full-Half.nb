Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Position", " ", "uncertainty", " ", "square"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Xsq", "[", 
      RowBox[{"\[Psi]_", ",", "\[Lambda]_", ",", "m_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "f", "}"}], ",", 
       RowBox[{
        RowBox[{"f", "=", 
         RowBox[{"\[Psi]", "[", 
          RowBox[{"\[Lambda]", ",", "m"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"f", "[", "x", "]"}], "2"], " ", 
            SuperscriptBox["x", "2"]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "x0", ",", "\[Infinity]"}], "}"}]}], "]"}], "-", 
         SuperscriptBox[
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox[
              RowBox[{"f", "[", "x", "]"}], "2"], " ", "x"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "x0", ",", "\[Infinity]"}], "}"}]}], "]"}], 
          "2"]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Momentum", " ", "uncertainty", " ", "square"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Psq", "[", 
      RowBox[{"\[Psi]_", ",", "\[Lambda]_", ",", "m_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "f", "}"}], ",", 
       RowBox[{
        RowBox[{"f", "=", 
         RowBox[{"\[Psi]", "[", 
          RowBox[{"\[Lambda]", ",", "m"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"f", "[", "x", "]"}]}], " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"f", "[", "x", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "x0", ",", "\[Infinity]"}], "}"}]}], "]"}], "-", 
         SuperscriptBox[
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"f", "[", "x", "]"}]}], " ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "x0", ",", "\[Infinity]"}], "}"}]}], "]"}], 
          "2"]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Uncertainty", " ", "product"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Delta]", "[", 
      RowBox[{"\[Psi]_", ",", "\[Lambda]_", ",", "m_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"Xsq", "[", 
        RowBox[{"\[Psi]", ",", "\[Lambda]", ",", "m"}], "]"}], "*", 
       RowBox[{"Psq", "[", 
        RowBox[{"\[Psi]", ",", "\[Lambda]", ",", "m"}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "Wavefunction", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Psi]", "[", 
      RowBox[{"\[Lambda]_", ",", "m_"}], "]"}], ":=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", "x", "}"}], ",", 
       RowBox[{"\[Psi]iso", "[", 
        RowBox[{"m", ",", " ", "\[Lambda]", ",", " ", 
         FractionBox["1", "2"], ",", " ", "x"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Remember", " ", "to", " ", "specify", " ", "the", " ", "x0"}], 
    "*)"}]}]}]], "Input",
