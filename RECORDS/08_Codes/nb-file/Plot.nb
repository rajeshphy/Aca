Cell["1.3 Isospectral Extension", "Item",
 CellChangeTimes->{{3.890614700777041*^9, 3.890614718136327*^9}, {
  3.8906157540168743`*^9, 
  3.890615755200718*^9}},ExpressionUUID->"99bddb48-dff1-4cd2-add4-\
d5b4450ce249"]
}, Open  ]],

Cell["\<\
Here we will generalize the superpotential and calculate the following using \
GS of REHO:
1.Integral I_0
2. General Superpotential
3. Partner potential
4. Isospectral Eigenfunctions\
\>", "Text",
 CellChangeTimes->{{3.890614700777041*^9, 3.890614837945878*^9}, {
  3.890614885214614*^9, 3.8906149033646393`*^9}, {3.8906149469904957`*^9, 
  3.8906149573489313`*^9}},ExpressionUUID->"8b479e5e-7919-4e73-ba29-\
62c60a54017d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"W", "[", "m_", "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"\[Psi]0", "[", "m", "]"}], "]"}], ",", "x"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"I0", "[", 
    RowBox[{"m_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[Psi]0", "[", "m", "]"}], "2"], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "\[Infinity]"}], ",", "x"}], "}"}]}], "]"}], "+", 
    "\[Lambda]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Wiso", "[", 
    RowBox[{"m_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"W", "[", "m", "]"}], "+", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"I0", "[", 
        RowBox[{"m", ",", "\[Lambda]"}], "]"}], "]"}], ",", "x"}], "]"}]}]}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{"Superpotential", " ", "Generalization"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Vpiso", "[", 
    RowBox[{"m_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Wiso", "[", 
      RowBox[{"m", ",", "\[Lambda]"}], "]"}], "2"], "+", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Wiso", "[", 
       RowBox[{"m", ",", "\[Lambda]"}], "]"}], ",", "x"}], "]"}], "+", 
    RowBox[{"\[Epsilon]", "[", "m", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Vmiso", "[", 
    RowBox[{"m_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Wiso", "[", 
      RowBox[{"m", ",", "\[Lambda]"}], "]"}], "2"], "-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Wiso", "[", 
       RowBox[{"m", ",", "\[Lambda]"}], "]"}], ",", "x"}], "]"}], "+", 
    RowBox[{"\[Epsilon]", "[", "m", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]0iso", "[", 
    RowBox[{"x_", ",", "m_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    SqrtBox[
     RowBox[{"\[Lambda]", 
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Lambda]"}], ")"}]}]], 
    RowBox[{"{", 
     FractionBox[
      RowBox[{"\[Psi]0", "[", "m", "]"}], 
      RowBox[{"I0", "[", 
       RowBox[{"m", ",", "\[Lambda]"}], "]"}]], "}"}]}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"GS", " ", "of", " ", "ISO"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Adagiso", "[", "m_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"D", "[", 
        RowBox[{"#", ",", "x"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"Wiso", "[", 
        RowBox[{"m", ",", "\[Lambda]"}], "]"}], "#"}]}], ")"}], "&"}]}], 
  RowBox[{"(*", " ", 
   RowBox[{"Raising", " ", "Operator"}], " ", "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]niso", "[", 
    RowBox[{"m_", ",", "n_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"Adagiso", "[", "m", "]"}], "[", 
     RowBox[{"\[Xi]", "[", "n", "]"}], "]"}], 
    SqrtBox[
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Epsilon]", "[", "m", "]"}]}], "-", 
      RowBox[{"\[Epsilon]", "[", "n", "]"}]}]]]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"RE", " ", "eigenfunction"}], " ", "*)"}], ";"}]}], "Input",
 CellChangeTimes->{{3.954548431115303*^9, 3.954548433480702*^9}, {
  3.9545485001219673`*^9, 3.9545485045732727`*^9}, {3.9545487774880466`*^9, 
  3.954548998995881*^9}, {3.954549328963621*^9, 3.954549354818828*^9}, {
  3.95454992220223*^9, 3.954549923291827*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"26dc7675-c41a-4cc4-be18-48fbadf8304e"],

Cell["Formula", "Item",
 CellChangeTimes->{{3.9537828165019207`*^9, 
  3.9537828218198357`*^9}},ExpressionUUID->"57a6f67a-874e-47ab-9214-\
d6559e80478e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Position", " ", "uncertainty", " ", "square"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Xsq", "[", 
      RowBox[{"\[Psi]_", ",", "n_", ",", "m_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "f", "}"}], ",", 
       RowBox[{
        RowBox[{"f", "=", 
         RowBox[{"\[Psi]", "[", 
          RowBox[{"n", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"f", "[", "x", "]"}], "2"], " ", 
            SuperscriptBox["x", "2"]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "x0", ",", "\[Infinity]"}], "}"}]}], "]"}], "-", 
         SuperscriptBox[
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox[
              RowBox[{"f", "[", "x", "]"}], "2"], " ", "x"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "x0", ",", "\[Infinity]"}], "}"}]}], "]"}], 
          "2"]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Momentum", " ", "uncertainty", " ", "square"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Psq", "[", 
      RowBox[{"\[Psi]_", ",", "n_", ",", "m_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "f", "}"}], ",", 
       RowBox[{
        RowBox[{"f", "=", 
         RowBox[{"\[Psi]", "[", 
          RowBox[{"n", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"f", "[", "x", "]"}]}], " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"f", "[", "x", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "x0", ",", "\[Infinity]"}], "}"}]}], "]"}], "-", 
         SuperscriptBox[
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"f", "[", "x", "]"}]}], " ", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "x0", ",", "\[Infinity]"}], "}"}]}], "]"}], 
          "2"]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Uncertainty", " ", "product"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Delta]", "[", 
      RowBox[{"\[Psi]_", ",", "n_", ",", "m_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"Xsq", "[", 
        RowBox[{"\[Psi]", ",", "n", ",", "m"}], "]"}], "*", 
       RowBox[{"Psq", "[", 
        RowBox[{"\[Psi]", ",", "n", ",", "m"}], "]"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.953785953788663*^9, 3.953785965284965*^9}, {
  3.953786050316903*^9, 3.95378607879088*^9}, {3.95378623975476*^9, 
  3.95378626714281*^9}, {3.953786774578429*^9, 3.953786794568824*^9}},
 CellLabel->
  "In[578]:=",ExpressionUUID->"3688d572-93ce-4708-ae1e-c97adc4bdf99"],

Cell["Full Line Calculation", "Item",
 CellChangeTimes->{
  3.953775170515399*^9, {3.9537763541867657`*^9, 
   3.953776362479753*^9}},ExpressionUUID->"a055f9eb-3b4a-420b-9cf1-\
6cd9541dd6f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Xi]", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{
       SqrtBox[
        FractionBox["\[Omega]x", 
         RowBox[{"2", " ", "\[Pi]"}]]], 
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["2", "n"], 
         RowBox[{"n", "!"}]}]]}]], 
     SuperscriptBox["E", 
      FractionBox[
       RowBox[{
        RowBox[{"-", " ", "\[Omega]x"}], " ", 
        SuperscriptBox["x", "2"]}], "4"]], 
     RowBox[{"HermiteH", "[", 
      RowBox[{"n", ",", 
       RowBox[{
        RowBox[{"\[Sqrt]", 
         RowBox[{"(", 
          FractionBox["\[Omega]x", "2"], ")"}]}], " ", "x"}]}], "]"}]}], "/.", 
    RowBox[{"\[Omega]x", "\[Rule]", "1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "x", "}"}], ",", 
     RowBox[{"\[Psi]flo", "[", 
      RowBox[{"n", ",", "m", ",", "x", ",", "1"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"-", "\[Infinity]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Epsilon]", "[", "m_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "2"], "+", " ", "m"}], ")"}]}], " ", "\[Omega]x"}], "/.", 
    RowBox[{"\[Omega]x", "\[Rule]", "1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]0", "[", "m_", "]"}], ":=", 
   RowBox[{"\[Psi]flo", "[", 
    RowBox[{"0", ",", "m", ",", "x", ",", "1"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.9537860732026787`*^9, {3.953786801415615*^9, 3.953786808050775*^9}, {
   3.954548710121557*^9, 3.954548711234254*^9}, {3.954549587060025*^9, 
   3.954549597274551*^9}, {3.954549935172708*^9, 3.954549936371682*^9}, {
   3.954549993310232*^9, 3.95454999699045*^9}, {3.954550639818228*^9, 
   3.9545506451696053`*^9}, 3.9545511190782146`*^9},
 CellLabel->"In[95]:=",ExpressionUUID->"8081f318-427a-45f1-9655-f1dd46065e9a"],

